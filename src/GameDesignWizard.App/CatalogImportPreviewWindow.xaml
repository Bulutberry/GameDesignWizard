<Window x:Class="GameDesignWizard.App.CatalogImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalog import preview"
        Width="760" Height="560" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="IMPORT PREVIEW" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
            <TextBlock Text="{Binding CategoryName, StringFormat=Import into {0}}"
                       FontFamily="Segoe UI Semibold" FontSize="28" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SourceFileName}" Foreground="{StaticResource MutedInkBrush}" FontSize="13" Margin="0,6,0,0" />
            <TextBlock Text="Review every row before changing the local catalog. Existing names and invalid rows will be skipped."
                       Foreground="{StaticResource MutedInkBrush}" FontSize="13" Margin="0,8,0,16" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="8">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ROW" Binding="{Binding SourceRow}" Width="70" />
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="170" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedInkBrush}" FontSize="13" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="{Binding ImportButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanImport}" Click="Import_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
