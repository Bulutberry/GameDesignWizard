<Window x:Class="GameDesignWizard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDesignWizard"
        Width="1280"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,34">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="GW" Foreground="White" FontFamily="Segoe UI Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GameDesign" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="15" />
                        <TextBlock Text="WIZARD" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource SidebarMutedTextBrush}" FontWeight="Bold" FontSize="11" Margin="17,0,0,8" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="⌂   Home" Command="{Binding NavigateHomeCommand}"
                                 IsChecked="{Binding IsHomeSelected, Mode=OneWay}" AutomationProperties.Name="Home" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="＋  Create Game Idea" Command="{Binding NavigateWizardCommand}"
                                 IsChecked="{Binding IsWizardSelected, Mode=OneWay}" AutomationProperties.Name="Create Game Idea" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="▦   Idea Pool" Command="{Binding NavigatePoolCommand}"
                                 IsChecked="{Binding IsPoolSelected, Mode=OneWay}" AutomationProperties.Name="Idea Pool" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="⚙   Settings" Command="{Binding NavigateSettingsCommand}"
                                 IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" AutomationProperties.Name="Settings" />
                </StackPanel>

                <Border Grid.Row="3" Background="#2A3850" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="LOCAL WORKSPACE" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Offline and private" Foreground="White" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="Prototype 0.2.0" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="54,42">
            <Grid Visibility="{Binding HomeVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="YOUR GAME DESIGN WORKSPACE" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Shape the next game worth making."
                               FontFamily="Segoe UI Semibold" FontSize="36" Margin="0,9,0,0" />
                    <TextBlock Text="Capture an idea, make the design concrete, and keep every project within reach."
                               Foreground="{StaticResource MutedInkBrush}" FontSize="15" Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,45,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding NavigateWizardCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="24" Height="238">
                            <StackPanel>
                                <Border Width="48" Height="48" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" HorizontalAlignment="Left">
                                    <TextBlock Text="＋" Foreground="{StaticResource AccentBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Create Game Idea" FontFamily="Segoe UI Semibold" FontSize="19" Margin="0,22,0,0" />
                                <TextBlock Text="Build a structured concept through a focused six-step flow."
                                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,9,0,0" />
                                <TextBlock Text="START A NEW IDEA  →" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,25,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding NavigatePoolCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="24" Height="238">
                            <StackPanel>
                                <Border Width="48" Height="48" Background="#E5F7F2" CornerRadius="12" HorizontalAlignment="Left">
                                    <TextBlock Text="▦" Foreground="#15866A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Idea Pool" FontFamily="Segoe UI Semibold" FontSize="19" Margin="0,22,0,0" />
                                <TextBlock Text="Browse, filter, edit, and export your growing catalog of concepts."
                                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,9,0,0" />
                                <TextBlock Text="VIEW YOUR IDEAS  →" Foreground="#15866A" FontWeight="Bold" FontSize="10" Margin="0,25,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="4" Command="{Binding NavigateSettingsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="24" Height="238">
                            <StackPanel>
                                <Border Width="48" Height="48" Background="#FFF1DF" CornerRadius="12" HorizontalAlignment="Left">
                                    <TextBlock Text="⚙" Foreground="#B66A09" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Settings" FontFamily="Segoe UI Semibold" FontSize="19" Margin="0,22,0,0" />
                                <TextBlock Text="Make every selection list and template fit the way you design."
                                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,9,0,0" />
                                <TextBlock Text="CUSTOMIZE WORKSPACE  →" Foreground="#B66A09" FontWeight="Bold" FontSize="10" Margin="0,25,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding WizardVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CREATE GAME IDEA" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Choose a target platform" FontFamily="Segoe UI Semibold" FontSize="32" Margin="0,8,0,0" />
                        <TextBlock Text="Select one option or leave this step empty and continue."
                                   Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="18" Padding="16,8" VerticalAlignment="Top">
                        <TextBlock Text="STEP 1 OF 6" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,33,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="5" Background="{StaticResource AccentBrush}" CornerRadius="3" />
                    <Border Grid.Column="1" Height="5" Background="#E1E3EC" CornerRadius="3" />
                </Grid>

                <ScrollViewer Grid.Row="2" Margin="0,35,0,20" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActivePlatforms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPlatformCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,16,16">
                                    <Border Width="190" Height="116" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="13" Padding="18">
                                        <StackPanel>
                                            <Border Width="36" Height="36" Background="{StaticResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="16"
                                                       TextTrimming="CharacterEllipsis" Margin="0,13,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" FontSize="13">
                        <Run Text="Selected: " />
                        <Run Text="{Binding SelectedPlatformName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Back to Home" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NavigateHomeCommand}" Margin="0,0,10,0" />
                        <Button Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ContinuePrototypeCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding PoolVisibility}">
                <StackPanel>
                    <TextBlock Text="IDEA POOL" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="Find your game ideas" FontFamily="Segoe UI Semibold" FontSize="32" Margin="0,8,0,0" />
                    <TextBlock Text="Every custom platform will be organized under Other while keeping its actual name."
                               Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,8,0,35" />
                    <UniformGrid Columns="3">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Height="170" Margin="0,0,14,0">
                            <StackPanel><TextBlock Text="PC" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Desktop game ideas" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Height="170" Margin="7,0">
                            <StackPanel><TextBlock Text="Mobile" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Phone and tablet ideas" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Height="170" Margin="14,0,0,0">
                            <StackPanel><TextBlock Text="Other" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Console, VR, board game, and custom platforms" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding SettingsVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="SETTINGS / CATALOGS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    <ComboBox ItemsSource="{Binding CatalogCategories}"
                              SelectedItem="{Binding SelectedCatalogCategory}"
                              DisplayMemberPath="DisplayName"
                              Width="260" Height="38" HorizontalAlignment="Left" Margin="0,12,0,0"
                              Padding="10,4" FontSize="14" />
                    <TextBlock Text="{Binding CatalogHeading}" FontFamily="Segoe UI Semibold" FontSize="32" Margin="0,12,0,0" />
                    <TextBlock Text="Changes appear immediately in the idea wizard. Archived options remain available to saved ideas."
                               Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="13" Padding="20" Margin="0,30,0,18">
                    <StackPanel>
                        <StackPanel Visibility="{Binding SubgenreParentVisibility}" Margin="0,0,0,14">
                            <TextBlock Text="Parent genre" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" />
                            <ComboBox ItemsSource="{Binding GenreChoices}"
                                      SelectedItem="{Binding SelectedParentGenre}"
                                      DisplayMemberPath="Name"
                                      Height="38" Padding="10,4" FontSize="14" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding NewCatalogOptionName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding CatalogInputHint}" />
                            <Button Grid.Column="1" Content="{Binding AddCatalogButtonLabel}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddCatalogOptionCommand}" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="3,0,0,10" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CatalogOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17,13" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="{StaticResource AccentSoftBrush}" CornerRadius="17">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#EFF7F3" CornerRadius="10" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}" Foreground="#247058" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                            <Button Grid.Column="3" Content="{Binding ToggleLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.ToggleCatalogOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="14,8" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
