<Window x:Class="GameDesignWizard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameDesignWizard.App.Controls"
        Title="GameDesignWizard"
        Width="1280"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,34">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="GW" Foreground="White" FontFamily="Segoe UI Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GameDesign" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="15" />
                        <TextBlock Text="WIZARD" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource SidebarMutedTextBrush}" FontWeight="Bold" FontSize="11" Margin="17,0,0,8" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="⌂   Home" Command="{Binding NavigateHomeCommand}"
                                 IsChecked="{Binding IsHomeSelected, Mode=OneWay}" AutomationProperties.Name="Home" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="＋  Create Game Idea" Command="{Binding NavigateWizardCommand}"
                                 IsChecked="{Binding IsWizardSelected, Mode=OneWay}" AutomationProperties.Name="Create Game Idea" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="▦   Idea Pool" Command="{Binding NavigatePoolCommand}"
                                 IsChecked="{Binding IsPoolSelected, Mode=OneWay}" AutomationProperties.Name="Idea Pool" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" Content="⚙   Settings" Command="{Binding NavigateSettingsCommand}"
                                 IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" AutomationProperties.Name="Settings" />
                </StackPanel>

                <Border Grid.Row="3" Background="#2A3850" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="LOCAL WORKSPACE" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Offline and private" Foreground="White" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="Prototype 0.15.0" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="54,42">
            <Grid Visibility="{Binding HomeVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="YOUR GAME DESIGN WORKSPACE" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Shape the next game worth making."
                               FontFamily="Segoe UI Semibold" FontSize="36" Margin="0,9,0,0" />
                    <TextBlock Text="Capture an idea, make the design concrete, and keep every project within reach."
                               Foreground="{StaticResource MutedInkBrush}" FontSize="15" Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,45,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding NavigateWizardCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="24" Height="238">
                            <StackPanel>
                                <Border Width="48" Height="48" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" HorizontalAlignment="Left">
                                    <TextBlock Text="＋" Foreground="{StaticResource AccentBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Create Game Idea" FontFamily="Segoe UI Semibold" FontSize="19" Margin="0,22,0,0" />
                                <TextBlock Text="Build a structured concept through a focused six-step flow."
                                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,9,0,0" />
                                <TextBlock Text="START A NEW IDEA  →" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,25,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding NavigatePoolCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="24" Height="238">
                            <StackPanel>
                                <Border Width="48" Height="48" Background="#E5F7F2" CornerRadius="12" HorizontalAlignment="Left">
                                    <TextBlock Text="▦" Foreground="#15866A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Idea Pool" FontFamily="Segoe UI Semibold" FontSize="19" Margin="0,22,0,0" />
                                <TextBlock Text="Browse, filter, edit, and export your growing catalog of concepts."
                                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,9,0,0" />
                                <TextBlock Text="VIEW YOUR IDEAS  →" Foreground="#15866A" FontWeight="Bold" FontSize="10" Margin="0,25,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="4" Command="{Binding NavigateSettingsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="24" Height="238">
                            <StackPanel>
                                <Border Width="48" Height="48" Background="#FFF1DF" CornerRadius="12" HorizontalAlignment="Left">
                                    <TextBlock Text="⚙" Foreground="#B66A09" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Settings" FontFamily="Segoe UI Semibold" FontSize="19" Margin="0,22,0,0" />
                                <TextBlock Text="Make every selection list and template fit the way you design."
                                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,9,0,0" />
                                <TextBlock Text="CUSTOMIZE WORKSPACE  →" Foreground="#B66A09" FontWeight="Bold" FontSize="10" Margin="0,25,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding WizardVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CREATE GAME IDEA" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="{Binding WizardTitle}" FontFamily="Segoe UI Semibold" FontSize="32" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding WizardInstructions}"
                                   Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="18" Padding="16,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding WizardStepLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,33,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="5" Background="{StaticResource AccentBrush}" CornerRadius="3" />
                    <Border Grid.Column="1" Height="5" Background="{Binding WizardSecondProgressColor}" CornerRadius="3" Margin="4,0,0,0" />
                    <Border Grid.Column="2" Height="5" Background="{Binding WizardThirdProgressColor}" CornerRadius="3" Margin="4,0,0,0" />
                    <Border Grid.Column="3" Height="5" Background="{Binding WizardFourthProgressColor}" CornerRadius="3" Margin="4,0,0,0" />
                    <Border Grid.Column="4" Height="5" Background="{Binding WizardFifthProgressColor}" CornerRadius="3" Margin="4,0,0,0" />
                    <Border Grid.Column="5" Height="5" Background="{Binding WizardSixthProgressColor}" CornerRadius="3" Margin="4,0,0,0" />
                </Grid>

                <ScrollViewer Grid.Row="2" Margin="0,35,0,20" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WizardStepOneVisibility}">
                    <ItemsControl ItemsSource="{Binding ActivePlatforms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPlatformCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,16,16">
                                    <Border Width="190" Height="116" BorderThickness="1" CornerRadius="13" Padding="18">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Width="36" Height="36" Background="{StaticResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding SelectionName}" FontFamily="Segoe UI Semibold" FontSize="16"
                                                       TextTrimming="CharacterEllipsis" Margin="0,13,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Margin="0,28,0,18" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WizardStepTwoVisibility}">
                    <StackPanel>
                        <TextBlock Text="Genre" FontFamily="Segoe UI Semibold" FontSize="18" />
                        <ItemsControl ItemsSource="{Binding Genres}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,10">
                                        <Border Padding="16,10" CornerRadius="9" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectionName}" FontWeight="SemiBold" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Subgenre" FontFamily="Segoe UI Semibold" FontSize="18" Margin="0,12,0,0" />
                        <TextBlock Text="Select a genre to see its related subgenres."
                                   Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,5,0,10" />
                        <ItemsControl ItemsSource="{Binding AvailableSubgenres}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSubgenreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,10">
                                        <Border Padding="14,9" CornerRadius="9" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectionName}" FontWeight="SemiBold" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:DualListPicker DataContext="{Binding TopicPicker}" Height="270" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Margin="0,35,0,20" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WizardStepThreeVisibility}">
                    <Grid Height="370">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:DualListPicker DataContext="{Binding FeaturePicker}" />
                        <controls:DualListPicker Grid.Column="2" DataContext="{Binding ArtStylePicker}" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Margin="0,35,0,20" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WizardStepFourVisibility}">
                    <controls:DualListPicker DataContext="{Binding MechanicsPicker}"
                                             Width="760" Height="370" HorizontalAlignment="Center" />
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Margin="0,28,0,20" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WizardStepFiveVisibility}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Links and notes" FontFamily="Segoe UI Semibold" FontSize="18" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Add reference" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddReferenceCommand}" Padding="16,9" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding References}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Reference URL" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" />
                                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="https://example.com/reference"
                                                         AutomationProperties.Name="Reference URL">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#D95555" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Text="{Binding ValidationMessage}" Foreground="#B83A3A" FontSize="11" Margin="2,5,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Reference note" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" />
                                                <TextBox Style="{StaticResource InputStyle}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                         Height="72" AutomationProperties.Name="Reference note" />
                                            </StackPanel>

                                            <Button Grid.Column="3" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="14,9" Margin="14,23,0,0" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Margin="0,28,0,20" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WizardStepSixVisibility}">
                    <StackPanel>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Core details" FontFamily="Segoe UI Semibold" FontSize="18" />
                                <TextBlock Text="Game name" FontWeight="SemiBold" FontSize="12" Margin="2,16,0,6" />
                                <TextBox Style="{StaticResource InputStyle}" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200" AutomationProperties.Name="Game name" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Estimated development duration" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding DevelopmentDurationChoices}"
                                                      SelectedItem="{Binding SelectedDevelopmentDuration}"
                                                      DisplayMemberPath="SelectionName" Height="42" Padding="10,5" FontSize="14"
                                                      AutomationProperties.Name="Estimated development duration" />
                                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ClearDevelopmentDurationCommand}" Padding="12,8" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Team size" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding TeamSizeChoices}"
                                                      SelectedItem="{Binding SelectedTeamSize}"
                                                      DisplayMemberPath="SelectionName" Height="42" Padding="10,5" FontSize="14"
                                                      AutomationProperties.Name="Team size" />
                                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ClearTeamSizeCommand}" Padding="12,8" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Development stage" FontWeight="SemiBold" FontSize="12" Margin="2,16,0,6" />
                                <ComboBox ItemsSource="{Binding DevelopmentStageChoices}"
                                          SelectedItem="{Binding SelectedDevelopmentStage}"
                                          Height="42" Padding="10,5" FontSize="14"
                                          AutomationProperties.Name="Development stage" />

                                <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="12" Margin="2,16,0,6" />
                                <TextBox Style="{StaticResource InputStyle}" Text="{Binding OverviewEnglish, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Height="110"
                                         AutomationProperties.Name="Game overview" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Media attachments" FontFamily="Segoe UI Semibold" FontSize="18" />
                                        <TextBlock Text="Images and audio are copied into managed storage when the idea is saved."
                                                   Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Add media" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="AddMedia_Click" Padding="16,9" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding MediaAttachments}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F8FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="9" Padding="13" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource AccentBrush}"
                                                                   FontWeight="Bold" FontSize="10" />
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding StorageState}" Foreground="{StaticResource MutedInkBrush}"
                                                                   FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Style="{StaticResource InputStyle}"
                                                             Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Optional caption or transcript note"
                                                             AutomationProperties.Name="Media caption" Margin="12,0" />
                                                    <Button Grid.Column="2" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.RemoveMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Padding="14,9" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Game design document" FontFamily="Segoe UI Semibold" FontSize="18" Margin="0,8,0,0" />
                        <TextBlock Text="Open only the sections you need. Empty sections remain optional."
                                   Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,5,0,12" />
                        <ItemsControl ItemsSource="{Binding GddSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                              Margin="0,0,0,9" Padding="15,12">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,12,0,2">
                                            <TextBlock Text="{Binding Guidance}" Foreground="{StaticResource MutedInkBrush}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9" />
                                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Height="120" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WizardSelectionSummary}" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WizardMessage}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{Binding WizardPreviousLabel}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding WizardPreviousCommand}" Margin="0,0,10,0" />
                        <Button Content="{Binding WizardNextLabel}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding WizardNextCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding PoolVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="IDEA POOL" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Find your game ideas" FontFamily="Segoe UI Semibold" FontSize="32" Margin="0,8,0,0" />
                        <TextBlock Text="Every custom platform is organized under Other while keeping its actual name."
                                   Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,8,0,0" />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,26,0,22">
                        <Button Command="{Binding SelectIdeaPoolFilterCommand}" CommandParameter="PC"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0"
                                HorizontalContentAlignment="Stretch" Cursor="Hand" AutomationProperties.Name="Show PC ideas">
                            <Border BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPcIdeaPoolFilterSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="PC" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PcIdeaCount}" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectIdeaPoolFilterCommand}" CommandParameter="Mobile"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="5,0"
                                HorizontalContentAlignment="Stretch" Cursor="Hand" AutomationProperties.Name="Show Mobile ideas">
                            <Border BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMobileIdeaPoolFilterSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Mobile" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MobileIdeaCount}" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectIdeaPoolFilterCommand}" CommandParameter="Other"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0"
                                HorizontalContentAlignment="Stretch" Cursor="Hand" AutomationProperties.Name="Show Other ideas">
                            <Border BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOtherIdeaPoolFilterSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Other" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OtherIdeaCount}" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Search ideas" FontWeight="SemiBold" FontSize="11" Margin="2,0,0,5" />
                                <TextBox Style="{StaticResource InputStyle}" Text="{Binding IdeaPoolSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search names, platforms, genres, topics, mechanics, features, and art styles"
                                         AutomationProperties.Name="Search saved ideas" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Development stage" FontWeight="SemiBold" FontSize="11" Margin="2,0,0,5" />
                                <ComboBox ItemsSource="{Binding IdeaPoolStageFilters}"
                                          SelectedItem="{Binding SelectedIdeaPoolStageFilter}"
                                          Height="42" Padding="10,5" FontSize="14"
                                          AutomationProperties.Name="Filter by development stage" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Clear filters" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearIdeaPoolFiltersCommand}" Padding="14,9" Margin="10,0,0,0"
                                    VerticalAlignment="Bottom" />
                            <Button Grid.Column="3" Command="{Binding SelectIdeaPoolFilterCommand}" CommandParameter="All"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="Show all pools">
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="14,9">
                                    <TextBlock Text="{Binding SelectedIdeaPoolFilterLabel}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="2,10,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IdeaPoolMessage}" Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanEditSelectedIdea}" Click="EditIdea_Click"
                                        Padding="15,8" Margin="0,0,8,0" AutomationProperties.Name="Edit selected idea" />
                                <Button Content="Export PDF" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanExportSelectedIdeaPdf}" Click="ExportIdeaPdf_Click"
                                        Padding="15,8" Margin="0,0,8,0" AutomationProperties.Name="Export selected idea as PDF" />
                                <Button Content="Export Filtered XLSX" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanExportFilteredIdeasWorkbook}" Click="ExportFilteredIdeasWorkbook_Click"
                                        Padding="15,8" Margin="0,0,8,0" AutomationProperties.Name="Export filtered ideas as Excel workbook" />
                                <Button Content="Export All XLSX" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanExportAllIdeasWorkbook}" Click="ExportAllIdeasWorkbook_Click"
                                        Padding="15,8" Margin="0,0,8,0" AutomationProperties.Name="Export all ideas as Excel workbook" />
                                <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                        IsEnabled="{Binding CanDeleteSelectedIdea}" Click="DeleteIdea_Click"
                                        Padding="15,8" AutomationProperties.Name="Delete selected idea" />
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding SavedIdeasView}"
                                  SelectedItem="{Binding SelectedSavedIdea, Mode=TwoWay}"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1" RowHeight="44" ColumnHeaderHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="Pool" Binding="{Binding PoolName}" Width="65" />
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="105" />
                                <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="105" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="125" />
                                <DataGridTextColumn Header="Team size" Binding="{Binding TeamSize}" Width="100" />
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="80" />
                                <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="125" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SettingsVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="SETTINGS / CATALOGS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox ItemsSource="{Binding CatalogCategories}"
                                  SelectedItem="{Binding SelectedCatalogCategory}"
                                  DisplayMemberPath="DisplayName"
                                  Width="260" Height="38"
                                  Padding="10,4" FontSize="14" />
                        <Button Content="Import TXT / XLSX" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ImportCatalog_Click" Padding="16,8" Margin="12,0,0,0" />
                        <Button Content="Export TXT / XLSX" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ExportCatalog_Click" Padding="16,8" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding CatalogHeading}" FontFamily="Segoe UI Semibold" FontSize="32" Margin="0,12,0,0" />
                    <TextBlock Text="Changes appear immediately in the idea wizard. Archived options remain available to saved ideas."
                               Foreground="{StaticResource MutedInkBrush}" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="13" Padding="20" Margin="0,30,0,18">
                    <StackPanel>
                        <StackPanel Visibility="{Binding SubgenreParentVisibility}" Margin="0,0,0,14">
                            <TextBlock Text="Parent genre" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" />
                            <ComboBox ItemsSource="{Binding GenreChoices}"
                                      SelectedItem="{Binding SelectedParentGenre}"
                                      DisplayMemberPath="Name"
                                      Height="38" Padding="10,4" FontSize="14" />
                        </StackPanel>
                        <TextBlock Text="{Binding CatalogExportDescription}" Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding NewCatalogOptionName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding CatalogInputHint}" />
                            <Button Grid.Column="1" Content="{Binding AddCatalogButtonLabel}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddCatalogOptionCommand}" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="3,0,0,10" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CatalogOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17,13" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="116" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="{StaticResource AccentSoftBrush}" CornerRadius="17">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="34" Padding="9,4"
                                                         AutomationProperties.Name="Catalog option name" />
                                                <TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#EFF7F3" CornerRadius="10" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}" Foreground="#247058" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Button Content="↑" ToolTip="Move up" AutomationProperties.Name="Move catalog option up"
                                                        Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Margin="0,0,4,0"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Command="{Binding DataContext.MoveCatalogOptionUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓" ToolTip="Move down" AutomationProperties.Name="Move catalog option down"
                                                        Style="{StaticResource SecondaryButtonStyle}" Padding="11,7"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Command="{Binding DataContext.MoveCatalogOptionDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="Save" ToolTip="Save name" AutomationProperties.Name="Save catalog option name"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.RenameCatalogOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="11,7" Margin="0,0,8,0" />
                                            <Button Grid.Column="5" Content="{Binding ToggleLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.ToggleCatalogOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="14,8" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
